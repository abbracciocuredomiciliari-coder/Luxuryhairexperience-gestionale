PORT=4100
MONGODB_URI=mongodb://127.0.0.1:27017/luxury_gestionale
JWT_SECRET=cambia-questo-segreto-in-produzione
# Password iniziale dell'admin creato dal seed (cambiala al primo accesso)
ADMIN_PASSWORD=Luxury2026!
# Origini consentite (frontend gestionale + sito prenotazioni)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# URL pubblico del sito (per i link magici nelle email — da configurare quando arriva la mail aziendale)
PUBLIC_SITE_URL=http://localhost:5173
# SMTP — da compilare quando esiste info@luxuryhairexperience.it
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Luxury Hair Experience <info@luxuryhairexperience.it>

# Prova AI generativa (tagli capelli / capi boutique sulla foto) — OPZIONALE
# provider: pollinations (account gratuito su pollinations.ai) oppure gemini (a pagamento)
AI_IMAGE_PROVIDER=pollinations
POLLINATIONS_TOKEN=
POLLINATIONS_MODEL=kontext
GEMINI_API_KEY=
